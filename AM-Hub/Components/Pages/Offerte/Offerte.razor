@page "/offerte"
@page "/am/offerte"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>Offerte zoeken</PageTitle>

<div class="quote-search-page">
    <header class="quote-search-hero">
        <h1>Offerte</h1>
        <p>Zoek een offerte om de details te bekijken en de PDF te downloaden.</p>
    </header>

    <section class="search-panel" aria-labelledby="search-title">
        <h2 id="search-title">Offerte zoeken</h2>
        <label for="quote-number">Offertenummer</label>
        <div class="search-controls">
            <input id="quote-number"
                   placeholder="Voer een offertenummer in..."
                   @bind="searchTerm"
                   @bind:event="oninput" />

            <button
                    type="button"
                    @onclick="Search">
                Zoeken
            </button>
        </div>
    </section>
</div>

@code {
    private string searchTerm = string.Empty;

    private void Search()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
            return;

        Navigation.NavigateTo(
            $"am/offerte/{Uri.EscapeDataString(searchTerm.Trim())}");
    }
}
