<hub-pdf-viewer data-pdf-url="@Source" data-sharepoint-url="@SharePointUrl" aria-label="@($"Monteursrapport bij werkorder {WorkOrderNumber}")">
    <p class="pdf-viewer-loading" role="status">Rapport laden…</p>
    <noscript>Schakel JavaScript in om het rapport hier te bekijken. <a href="@SharePointUrl" target="_blank" rel="noopener noreferrer">Open in SharePoint</a></noscript>
</hub-pdf-viewer>

@code {
    [Parameter, EditorRequired] public string Source { get; set; } = "";
    [Parameter, EditorRequired] public string WorkOrderNumber { get; set; } = "";
    [Parameter] public string? SharePointUrl { get; set; }
}
