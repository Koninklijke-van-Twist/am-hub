<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Last known-good production (8 Jul) was already net10.0. Do not retarget without a host runtime change. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AM_Hub</RootNamespace>
    <!-- systemd reads dllpointer; must match AM-Hub/dllpointer and the published file. -->
    <AssemblyName>AM-Hub</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/.tmp-*/**;**/.tmp-*;**/.vs/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.14.2" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>

</Project>
