<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net8.0 matches the Ubuntu host's ASP.NET Core 8 runtime. Do not bump without installing that runtime on the server. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AM_Hub</RootNamespace>
    <!-- systemd reads dllpointer; keep this name stable and equal to AM-Hub/dllpointer. -->
    <AssemblyName>AM-Hub</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/.tmp-*/**;**/.tmp-*;**/.vs/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.14.2" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>

</Project>
